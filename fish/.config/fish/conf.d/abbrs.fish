abbr -a -- ld lazydocker
abbr -a -- lg lazygit
abbr -a -- . 'nvim .'

abbr -a -- gd 'git diff'
abbr -a -- gs 'git status'
abbr -a -- gl 'git log --oneline --graph --decorate'
abbr -a -- gcm 'git commit -m'
abbr -a -- ga 'git add'
abbr -a -- gaa 'git add --all'

abbr -a -- dps 'sudo docker ps'
abbr -a -- dl 'sudo docker logs'
abbr -a -- de 'sudo docker exec -it'
abbr -a -- dcu 'sudo docker compose up -d'
abbr -a -- dcd 'sudo docker compose down'

abbr -a -- dka 'cd $HOME/App/kadk-nextcloud'
abbr -a -- hypr 'cd $HOME/.config/hypr/'
abbr -a -- conf 'cd $HOME/.config/'

abbr -a -- ... 'cd ../../'
abbr -a -- .... 'cd ../../../'
abbr -a -- ..... 'cd ../../../../'

abbr -a -- down 'just down'
abbr -a -- up 'just devenv-deploy'
abbr -a -- shokz 'bluetoothctl connect A0:0C:E2:D6:25:A5'
abbr -a -- saveabbr 'abbr > ~/dotfiles/fish/.config/fish/conf.d/abbrs.fish'
